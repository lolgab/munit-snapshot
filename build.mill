//| mill-version: 1.3.1
//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.2
package build

import mill.*, scalalib.*, scalajslib.*, scalajslib.api.JsEnvConfig, scalanativelib.*, publish.*
import com.goyeau.mill.scalafix.ScalafixModule

/** A library published for the JVM, Scala.js and Scala Native, as
  * `snaptest-<name>`
  */
trait SnaptestProject extends Module:
  def deps: Seq[Dep] = Nil
  // Dependencies only published for Scala 2.13, which Scala 3 can use
  def scala2Deps: Seq[Dep] = Nil
  def upstream: Seq[SnaptestProject] = Nil
  def testDeps: Seq[Dep] = Nil
  def testFramework: String = "munit.Framework"

  trait Common
      extends PlatformScalaModule,
        PublishModule,
        ScalafixModule,
        mill.util.VcsVersionModule:
    def scalaVersion = "3.9.0"
    def artifactName =
      s"snaptest-${SnaptestProject.this.moduleSegments.last.value}"
    def mvnDeps = super.mvnDeps() ++ deps ++
      scala2Deps.map(_.withDottyCompat(scalaVersion()))
    def pomSettings =
      PomSettings(
        description = "Snapshot testing for Scala",
        organization = "com.github.lolgab",
        url = "https://github.com/lolgab/snaptest",
        licenses = Seq(License.MIT),
        versionControl = VersionControl.github("lolgab", "snaptest"),
        developers = Seq(
          Developer("lolgab", "Lorenzo Gabriele", "https://github.com/lolgab")
        )
      )

    def scalacOptions = super.scalacOptions() ++ Seq(
      "-deprecation",
      "-feature",
      "-Wunused:all",
      "-new-syntax"
    )

  trait CommonTests extends TestModule:
    def testFramework = SnaptestProject.this.testFramework
    def mvnDeps = super.mvnDeps() ++ testDeps

  // Sources shared by the platforms with java.nio.file
  trait JvmNative extends Common:
    def jvmNativeSources = Task.Sources("src-jvm-native")
    def sources = Task { super.sources() ++ jvmNativeSources() }

  object jvm extends JvmNative:
    def moduleDeps = upstream.map(_.jvm)
    object test extends ScalaTests, CommonTests

  object js extends Common, ScalaJSModule:
    def scalaJSVersion = "1.22.0"
    def moduleDeps = upstream.map(_.js)
    object test extends ScalaJSTests, CommonTests:
      // Node.js inherits the environment of the Mill daemon, so forward the
      // variables controlling snapshots from the client
      def snapshotEnv = Task.Input {
        Task.env.filter((k, _) => k == "CI" || k == "SNAPTEST")
      }
      def jsEnvConfig = Task {
        super.jsEnvConfig() match
          case node: JsEnvConfig.NodeJs =>
            node.copy(env = node.env ++ snapshotEnv())
          case other => other
      }

  object native extends JvmNative, ScalaNativeModule:
    def scalaNativeVersion = "0.5.12"
    def moduleDeps = upstream.map(_.native)
    object test extends ScalaNativeTests, CommonTests

object core extends SnaptestProject:
  override def deps = Seq(mvn"com.lihaoyi::pprint::0.9.6")
  override def scala2Deps =
    Seq(mvn"org.portable-scala::portable-scala-reflect::1.1.3")
  override def testDeps = Seq(mvn"org.scalameta::munit::1.3.6")

object munit extends SnaptestProject:
  override def upstream = Seq(core)
  override def deps = Seq(mvn"org.scalameta::munit::1.3.6")

object scalatest extends SnaptestProject:
  override def upstream = Seq(core)
  override def deps = Seq(
    mvn"org.scalatest::scalatest::3.2.20",
    mvn"com.lihaoyi::sourcecode::0.4.4"
  )
  override def testFramework = "org.scalatest.tools.Framework"

object utest extends SnaptestProject:
  override def upstream = Seq(core)
  override def deps = Seq(mvn"com.lihaoyi::utest::0.9.5")
  override def testFramework = "utest.runner.Framework"

object specs2 extends SnaptestProject:
  override def upstream = Seq(core)
  override def deps = Seq(
    mvn"org.specs2::specs2-core::5.11.0",
    mvn"com.lihaoyi::sourcecode::0.4.4"
  )
  override def testFramework = "org.specs2.runner.Specs2Framework"

object `munit-cats-effect` extends SnaptestProject:
  override def upstream = Seq(munit)
  override def deps = Seq(mvn"org.typelevel::munit-cats-effect::2.2.1")

object weaver extends SnaptestProject:
  override def upstream = Seq(core)
  override def deps = Seq(
    mvn"org.typelevel::weaver-cats::0.13.1",
    mvn"com.lihaoyi::sourcecode::0.4.4"
  )
  override def testFramework = "weaver.framework.CatsEffect"

object zio extends SnaptestProject:
  override def upstream = Seq(core)
  override def deps = Seq(
    mvn"dev.zio::zio-test::2.1.27",
    mvn"com.lihaoyi::sourcecode::0.4.4"
  )
  override def testDeps = Seq(mvn"dev.zio::zio-test-sbt::2.1.27")
  override def testFramework = "zio.test.sbt.ZTestFramework"
