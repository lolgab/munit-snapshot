//| mill-version: 1.3.1
//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.2
package build

import mill.*, scalalib.*, scalanativelib.*, publish.*
import com.goyeau.mill.scalafix.ScalafixModule

object `munit-snapshot` extends Module:
  trait Common
      extends PlatformScalaModule,
        PublishModule,
        ScalafixModule,
        mill.util.VcsVersionModule:
    def scalaVersion = "3.9.0"
    def artifactName = "munit-snapshot"
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.scalameta::munit::1.3.6",
      mvn"com.lihaoyi::upickle::4.4.3",
      mvn"com.lihaoyi::os-lib::0.11.10"
    )
    def pomSettings =
      PomSettings(
        description = "Snapshot testing for MUnit",
        organization = "com.github.lolgab",
        url = "https://github.com/lolgab/munit-snapshot",
        licenses = Seq(License.MIT),
        versionControl = VersionControl.github("lolgab", "munit-snapshot"),
        developers = Seq(
          Developer("lolgab", "Lorenzo Gabriele", "https://github.com/lolgab")
        )
      )

    def scalacOptions = super.scalacOptions() ++ Seq(
      "-deprecation",
      "-feature",
      "-Wunused:all",
      "-new-syntax"
    )

  trait CommonTest extends ScalaModule, TestModule.Munit:
    // Snapshot files live next to the test sources, so changing them
    // must invalidate the test results
    def jsonFiles = Task.Input {
      os.walk(moduleDir)
        .filter(f => os.isFile(f) && f.ext == "json")
        .map(PathRef(_))
    }
    def compile = Task {
      jsonFiles()
      super.compile()
    }

  object jvm extends Common:
    object test extends ScalaTests, CommonTest

  object native extends Common, ScalaNativeModule:
    def scalaNativeVersion = "0.5.12"
    object test extends ScalaNativeTests, CommonTest
